# Gemini API Key (Structured Output extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Serper.dev Search API Key (PDF manual discovery)
SERPER_API_KEY=your_serper_api_key_here

# Amazon Associates Affiliate Tag (defaults to fixmycode-20)
AMAZON_TAG=fixmycode-20

# Canonical Site Domain
SITE_DOMAIN=https://fixmycode.com

# IndexNow API Key for Bing / Yandex submission
INDEXNOW_KEY=your_indexnow_api_key_here
