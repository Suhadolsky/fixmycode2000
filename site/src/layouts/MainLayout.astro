---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Authoritative equipment service manual troubleshooting and error code database. Step-by-step repair guides, verified OEM parts, and diagnostic procedures.",
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-slate-50 text-slate-900 antialiased selection:bg-amber-100 selection:text-amber-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | FixMyCode Database</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-slate-900 bg-slate-50">
    <!-- Top Engineering Status Strip -->
    <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4 border-b border-slate-800">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="font-mono uppercase tracking-wider text-[11px] text-slate-200">System Status: Service Manual Index Live</span>
        </div>
        <div class="flex items-center gap-4 text-[11px] text-slate-400 font-mono">
          <span>OEM Technical Standard</span>
          <span>•</span>
          <span>Zero-Cost Troubleshooting</span>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-lg bg-amber-500 flex items-center justify-center text-white font-bold text-lg shadow-sm group-hover:bg-amber-600 transition">
            <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-slate-900 flex items-center gap-1">
              FixMy<span class="text-amber-600">Code</span>
            </span>
            <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 -mt-1">Technical Fault Database</span>
          </div>
        </a>

        <!-- Header Nav Links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-amber-600 transition">Database Directory</a>
          <a href="/bosch/" class="hover:text-amber-600 transition">Bosch</a>
          <a href="/pentair/" class="hover:text-amber-600 transition">Pentair</a>
          <a href="/breville/" class="hover:text-amber-600 transition">Breville</a>
          <a href="/hayward/" class="hover:text-amber-600 transition">Hayward</a>
          <a href="/navien/" class="hover:text-amber-600 transition">Navien</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 text-sm mt-16 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-2">
              <span class="text-lg font-black tracking-tight text-white">FixMy<span class="text-amber-500">Code</span></span>
              <span class="text-xs bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-mono">v2.5 OEM</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-400 max-w-md">
              An authoritative technical directory extracting fault codes, diagnostic procedures, and repair specifications from manufacturer service manuals and engineering tech sheets.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-mono uppercase tracking-wider text-slate-200 mb-3">Popular Brands</h4>
            <ul class="space-y-1.5 text-xs">
              <li><a href="/bosch/" class="hover:text-amber-400 transition">Bosch Dishwashers & Appliances</a></li>
              <li><a href="/pentair/" class="hover:text-amber-400 transition">Pentair Pool Heaters & Automation</a></li>
              <li><a href="/breville/" class="hover:text-amber-400 transition">Breville Espresso & Kitchen Machines</a></li>
              <li><a href="/hayward/" class="hover:text-amber-400 transition">Hayward Variable Speed Pumps</a></li>
              <li><a href="/navien/" class="hover:text-amber-400 transition">Navien Condensing Tankless Heaters</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-mono uppercase tracking-wider text-slate-200 mb-3">Diagnostic Safety</h4>
            <ul class="space-y-1.5 text-xs text-slate-400">
              <li>Always disconnect electrical power before servicing equipment.</li>
              <li>Verify high-voltage lines using calibrated multimeters.</li>
              <li>Turn off main gas shutoff valves prior to combustion servicing.</li>
            </ul>
          </div>
        </div>

        <!-- Mandatory Amazon Associates Compliance & Disclaimer -->
        <div class="pt-8 border-t border-slate-800 text-xs leading-relaxed space-y-3 text-slate-400">
          <p class="font-medium text-slate-300">
            <strong>Amazon Associates Mandatory Disclaimer:</strong> FixMyCode is an independent technical database and is not affiliated with, endorsed by, or sponsored by Bosch, Pentair, Breville, Hayward, Navien, or any other equipment manufacturer. FixMyCode is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.
          </p>
          <p>
            Product prices and availability are accurate as of the date/time indicated and are subject to change. Any price and availability information displayed on Amazon.com at the time of purchase will apply to the purchase of this product.
          </p>
          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 text-slate-400 font-mono text-[11px]">
            <span>&copy; {new Date().getFullYear()} FixMyCode Engineering Database. All rights reserved.</span>
            <span>Programmatic SEO Engine • Fast Astro 5 Build</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
