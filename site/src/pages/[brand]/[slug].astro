---
import MainLayout from '../../layouts/MainLayout.astro';
import EmergencyRepairCard from '../../components/EmergencyRepairCard.astro';
import RepairKitBox from '../../components/RepairKitBox.astro';
import SchemaLD from '../../components/SchemaLD.astro';
import errorsDb from '../../data/errors_db.json';

export async function getStaticPaths() {
  // FIX 2: Group items by brand and equipment_type for Ring Linking Architecture
  const brandGroups = new Map<string, any[]>();
  const equipGroups = new Map<string, any[]>();

  errorsDb.forEach((item: any) => {
    const brand = item.brand;
    if (!brandGroups.has(brand)) brandGroups.set(brand, []);
    brandGroups.get(brand)!.push(item);

    const equip = item.equipment_type;
    if (!equipGroups.has(equip)) equipGroups.set(equip, []);
    equipGroups.get(equip)!.push(item);
  });

  return errorsDb.map((item: any) => {
    const brandSlug = item.brand_slug || item.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const slug = item.slug;

    // 1. 6 related items within the same brand using circular modulo indexing
    const brandItems = brandGroups.get(item.brand) || [];
    const brandIdx = brandItems.findIndex((it) => it.slug === item.slug);
    const relatedErrors: any[] = [];
    const brandCount = Math.min(6, brandItems.length - 1);
    for (let i = 1; i <= brandCount; i++) {
      relatedErrors.push(brandItems[(brandIdx + i) % brandItems.length]);
    }

    // 2. 4 cross-brand items sharing the same equipment_type matched by component / symptom or circular modulo
    const crossBrandCandidates = (equipGroups.get(item.equipment_type) || []).filter((it) => it.brand !== item.brand);
    const candidates = crossBrandCandidates.length > 0 ? crossBrandCandidates : (equipGroups.get(item.equipment_type) || []).filter((it) => it.slug !== item.slug);

    const stopWords = new Set(['error', 'code', 'fault', 'system', 'check', 'open', 'high', 'low', 'circuit', 'signal', 'sensor', 'unit']);
    const itemKeywords = `${item.primary_part_name} ${item.short_symptom}`
      .toLowerCase()
      .split(/[^a-z0-9]+/)
      .filter((w) => w.length >= 4 && !stopWords.has(w));

    const scoredCandidates = candidates.map((cand) => {
      const text = `${cand.primary_part_name} ${cand.short_symptom}`.toLowerCase();
      let score = 0;
      for (const kw of itemKeywords) {
        if (text.includes(kw)) score += 1;
      }
      return { cand, score };
    });

    scoredCandidates.sort((a, b) => b.score - a.score);

    const relatedCategoryErrors: any[] = [];
    for (const sc of scoredCandidates) {
      if (sc.score > 0 && relatedCategoryErrors.length < 4) {
        relatedCategoryErrors.push(sc.cand);
      }
    }

    const offset = brandIdx >= 0 ? brandIdx : 0;
    let fillK = 0;
    while (relatedCategoryErrors.length < Math.min(4, candidates.length) && fillK < candidates.length) {
      const cand = candidates[(offset + fillK) % candidates.length];
      if (!relatedCategoryErrors.some((it) => it.slug === cand.slug)) {
        relatedCategoryErrors.push(cand);
      }
      fillK++;
    }

    return {
      params: {
        brand: brandSlug,
        slug: slug,
      },
      props: {
        errorItem: item,
        relatedErrors,
        relatedCategoryErrors,
      },
    };
  });
}

interface Props {
  errorItem: any;
  relatedErrors: any[];
  relatedCategoryErrors: any[];
}

const { errorItem, relatedErrors = [], relatedCategoryErrors = [] } = Astro.props;

const brandSlug = errorItem.brand_slug || errorItem.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const equipSlug = (errorItem.equipment_type || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'equipment';
const canonicalUrl = `https://gettinytool.com/${brandSlug}/${errorItem.slug}/`;

// FIX 3.2: High-intent long-tail SEO metadata including OEM Part Number
const pageTitle = `${errorItem.brand} ${errorItem.model_series} Error ${errorItem.error_code} Fix: ${errorItem.short_symptom} (OEM #${errorItem.oem_part_number})`;
const pageDesc = `${errorItem.brand} ${errorItem.model_series} showing error code ${errorItem.error_code}? Caused by faulty ${errorItem.primary_part_name} (OEM #${errorItem.oem_part_number}). Check multimeter specs (${errorItem.multimeter_spec}) and 3-step replacement guide.`;
const h1Title = `${errorItem.brand} ${errorItem.model_series} Error Code ${errorItem.error_code} — ${errorItem.short_symptom} (OEM #${errorItem.oem_part_number})`;
---

<MainLayout title={pageTitle} description={pageDesc} canonicalUrl={canonicalUrl}>
  <!-- Schema.org JSON-LD Injected to Head with mpn & Breadcrumbs -->
  <Fragment slot="head">
    <SchemaLD
      brand={errorItem.brand}
      modelSeries={errorItem.model_series}
      errorCode={errorItem.error_code}
      shortSymptom={errorItem.short_symptom}
      plainEnglishMeaning={errorItem.plain_english_meaning}
      estimatedCost={errorItem.estimated_pro_repair_cost}
      steps={errorItem.diagnostic_and_fix_steps}
      primaryPartName={errorItem.primary_part_name}
      oemPartNumber={errorItem.oem_part_number}
      brandSlug={brandSlug}
      slug={errorItem.slug}
      consumableName={errorItem.consumable_name}
      requiredToolName={errorItem.required_tool_name}
      faqQuestions={errorItem.faq_questions}
      equipmentType={errorItem.equipment_type}
    />
  </Fragment>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <!-- 1. Breadcrumbs (Above the Fold) -->
    <nav class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-500 mb-3" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-600 transition">Home</a>
      <span>&gt;</span>
      <a href={`/directory/#${equipSlug}`} class="hover:text-amber-600 transition">{errorItem.equipment_type} Directory</a>
      <span>&gt;</span>
      <a href={`/${brandSlug}/`} class="hover:text-amber-600 transition">{errorItem.brand} Error Codes</a>
      <span>&gt;</span>
      <span class="font-bold text-amber-700">{errorItem.brand} {errorItem.error_code} Fix</span>
    </nav>

    <!-- 2. H1 Header (Above the Fold) -->
    <header class="space-y-2 mb-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-block px-2.5 py-0.5 rounded bg-amber-500 text-slate-950 font-mono font-black text-xs uppercase shadow-xs">
          FAULT CODE: {errorItem.error_code}
        </span>
        <span class="text-xs font-mono text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">
          {errorItem.equipment_type} • {errorItem.model_series}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 leading-tight">
        {h1Title}
      </h1>
    </header>

    <!-- 3. Mandatory Amazon Compliance (Top of Card) -->
    <div class="text-[11px] text-slate-500 font-mono italic my-2">
      As an Amazon Associate, we earn from qualifying purchases.
    </div>

    <!-- 4. Above-the-Fold Emergency Spec Card -->
    <EmergencyRepairCard
      brand={errorItem.brand}
      modelSeries={errorItem.model_series}
      errorCode={errorItem.error_code}
      partName={errorItem.primary_part_name}
      oemPartNumber={errorItem.oem_part_number}
      crossRefNumbers={errorItem.cross_ref_numbers}
      multimeterSpec={errorItem.multimeter_spec}
      toolsNeeded={errorItem.tools_needed}
      partAffiliateUrl={errorItem.part_affiliate_url}
      requiredToolName={errorItem.required_tool_name}
      toolAffiliateUrl={errorItem.tool_affiliate_url}
      amazonTag="amazinrevie0a-20"
    />

    <!-- 5. Diagnostic Status Bar (3 Badges) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-6 p-4 rounded-xl bg-slate-900 text-white font-mono text-xs">
      <div class="flex items-center gap-2.5">
        <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">DIY Difficulty</span>
          <span class="font-bold text-white text-xs">{errorItem.diy_difficulty}</span>
        </div>
      </div>
      <div class="flex items-center gap-2.5">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">Est. Pro Service Cost</span>
          <span class="font-bold text-white text-xs">{errorItem.estimated_pro_repair_cost}</span>
        </div>
      </div>
      <div class="flex items-center gap-2.5">
        <div class="w-2.5 h-2.5 rounded-full bg-blue-400"></div>
        <div>
          <span class="text-slate-400 block text-[10px] uppercase">Est. DIY Savings</span>
          <span class="font-bold text-emerald-300 text-xs font-mono">~75% Saved</span>
        </div>
      </div>
    </div>

    <!-- 6. THE 3-PIECE REPAIR BUNDLE: RepairKitBox Component -->
    <RepairKitBox
      brand={errorItem.brand}
      errorCode={errorItem.error_code}
      primaryPartName={errorItem.primary_part_name}
      oemPartNumber={errorItem.oem_part_number}
      partAffiliateUrl={errorItem.part_affiliate_url}
      requiredToolName={errorItem.required_tool_name}
      toolAffiliateUrl={errorItem.tool_affiliate_url}
      consumableName={errorItem.consumable_name}
      consumableAffiliateUrl={errorItem.consumable_affiliate_url}
      bundleCartUrl={errorItem.bundle_cart_url}
      hasAsinBundle={false}
    />

    <!-- ==================== BELOW THE FOLD ==================== -->

    <!-- FIX 3.1: Technical Specifications & Diagnostic Matrix Table -->
    <section class="my-8">
      <div class="border border-slate-200 rounded-2xl p-6 bg-white shadow-xs">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900">
            Technical Specifications &amp; Diagnostic Matrix
          </h2>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm font-sans border-collapse">
            <tbody class="divide-y divide-slate-200">
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70 w-1/3">Manufacturer / Brand</th>
                <td class="py-2.5 px-3 font-bold text-slate-900">{errorItem.brand}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Equipment Category</th>
                <td class="py-2.5 px-3 text-slate-800">{errorItem.equipment_type}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Model / Series</th>
                <td class="py-2.5 px-3 font-mono text-slate-800">{errorItem.model_series}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Fault Code / Indicator</th>
                <td class="py-2.5 px-3 font-mono font-bold text-amber-700">{errorItem.error_code}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Faulty Subsystem</th>
                <td class="py-2.5 px-3 font-medium text-slate-900">{errorItem.primary_part_name}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Verified OEM Part Number</th>
                <td class="py-2.5 px-3 font-mono font-bold text-slate-900 bg-amber-50/50">{errorItem.oem_part_number}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">Trigger Condition</th>
                <td class="py-2.5 px-3 text-slate-700 leading-relaxed">{errorItem.plain_english_meaning}</td>
              </tr>
              <tr class="hover:bg-slate-50 transition">
                <th class="py-2.5 px-3 font-semibold text-slate-600 bg-slate-50/70">DIY Time &amp; Pro Cost Comparison</th>
                <td class="py-2.5 px-3 font-mono text-xs">
                  <span class="text-slate-900 font-bold">{errorItem.diy_difficulty}</span>
                  <span class="text-slate-400 mx-1.5">•</span>
                  <span class="text-emerald-700 font-semibold">Pro dispatch: {errorItem.estimated_pro_repair_cost}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Section 1: What Causes Brand Error Code? -->
    <section class="my-8">
      <div class="border border-slate-200 rounded-2xl p-6 bg-white shadow-xs">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">
            What Causes {errorItem.brand} Error {errorItem.error_code}?
          </h2>
        </div>
        <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
          {errorItem.plain_english_meaning}
        </p>

        <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between text-xs text-slate-500 font-mono">
          <span>Equipment: {errorItem.equipment_type}</span>
          <span>OEM Reference Part: {errorItem.oem_part_number}</span>
        </div>
      </div>
    </section>

    <!-- Section 2: Step-by-Step Troubleshooting Checklist -->
    <section class="my-10">
      <div class="border border-slate-200 rounded-2xl p-6 sm:p-8 bg-white shadow-xs">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
              Step-by-Step Troubleshooting &amp; Replacement Procedure
            </h2>
            <p class="text-xs text-slate-500 mt-1">
              Click checkboxes as you finish each diagnostic phase to track your repair progress.
            </p>
          </div>
          <span class="hidden sm:inline-block text-xs font-mono bg-slate-100 text-slate-700 px-3 py-1 rounded">
            {errorItem.diagnostic_and_fix_steps.length} Steps
          </span>
        </div>

        <ol class="space-y-4 font-sans text-sm sm:text-base">
          {errorItem.diagnostic_and_fix_steps.map((step: string, index: number) => (
            <li class="flex items-start gap-3.5 p-3.5 rounded-xl border border-slate-200/80 hover:border-amber-400/80 bg-slate-50/50 transition checklist-item">
              <label class="flex items-start gap-3.5 cursor-pointer w-full">
                <input
                  type="checkbox"
                  class="mt-1 w-4 h-4 rounded text-amber-600 border-slate-300 focus:ring-amber-500 shrink-0 cursor-pointer checklist-checkbox"
                />
                <div class="flex-1">
                  <span class="font-mono font-bold text-slate-900 text-xs block mb-0.5 text-amber-700 uppercase">
                    Step {index + 1}
                  </span>
                  <span class="text-slate-800 leading-relaxed step-text">
                    {step}
                  </span>
                </div>
              </label>
            </li>
          ))}
        </ol>

        <!-- Mid-article In-line Part Reminder CTA -->
        <div class="mt-8 p-4 rounded-xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="text-xs text-amber-900 font-medium">
            <strong>Ready to install?</strong> Make sure you have the replacement part before disassembling.
          </div>
          <a
            href={errorItem.part_affiliate_url}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="inline-flex items-center justify-center text-xs font-bold font-mono px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white shadow-xs shrink-0 transition"
          >
            Order {errorItem.primary_part_name} &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 3: Frequently Asked Questions (FAQ) -->
    {errorItem.faq_questions && errorItem.faq_questions.length > 0 && (
      <section class="my-10">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 mb-4">
          Frequently Asked Questions About Error {errorItem.error_code}
        </h2>
        <div class="space-y-4">
          {errorItem.faq_questions.map((faq: any) => (
            <div class="border border-slate-200 rounded-xl p-5 bg-white shadow-xs">
              <h3 class="text-base font-bold text-slate-900 mb-2">
                {faq.question}
              </h3>
              <p class="text-sm text-slate-700 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- TASK 2.1: Circular Ring Linking Section 1 (Same-Brand / Same-Series Ring - 6 Links) -->
    {relatedErrors.length > 0 && (
      <section class="my-12 pt-8 border-t border-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Related {errorItem.brand} {errorItem.model_series} Fault Codes &amp; Fixes
            </h2>
            <p class="text-xs text-slate-500">
              Diagnostic procedures and OEM part numbers for sibling {errorItem.brand} error codes
            </p>
          </div>
          <a
            href={`/${brandSlug}/`}
            class="text-xs font-mono text-amber-600 hover:text-amber-700 font-semibold transition"
          >
            View All {errorItem.brand} Guides &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {relatedErrors.map((rel: any) => {
            const relBrandSlug = rel.brand_slug || rel.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            return (
              <a
                href={`/${relBrandSlug}/${rel.slug}/`}
                class="p-4 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-md transition group flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-1 mb-2">
                    <span class="inline-block px-2 py-0.5 rounded font-mono font-bold text-xs bg-amber-50 text-amber-700 border border-amber-200 group-hover:bg-amber-100 transition">
                      {rel.error_code}
                    </span>
                    <span class="text-[11px] font-mono text-slate-400 truncate max-w-[130px]">
                      OEM: {rel.oem_part_number}
                    </span>
                  </div>
                  <h3 class="text-sm font-semibold text-slate-900 line-clamp-1 group-hover:text-amber-600 transition">
                    {rel.short_symptom}
                  </h3>
                  <p class="text-xs text-slate-500 line-clamp-1 mt-1 font-mono">
                    Part: {rel.primary_part_name}
                  </p>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono text-slate-500">
                  <span class="truncate max-w-[150px]">{rel.model_series}</span>
                  <span class="text-amber-600 font-bold group-hover:translate-x-0.5 transition">Fix &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- TASK 2.2: Cross-Brand Component / Symptom Links (4 Links) -->
    {relatedCategoryErrors.length > 0 && (
      <section class="my-12 pt-8 border-t border-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Similar {errorItem.equipment_type} Component Diagnostics
            </h2>
            <p class="text-xs text-slate-500">
              Cross-manufacturer fault code guides and component tests for {errorItem.equipment_type.toLowerCase()}s
            </p>
          </div>
          <a
            href={`/directory/#${equipSlug}`}
            class="text-xs font-mono bg-slate-100 text-slate-700 hover:bg-amber-100 hover:text-amber-800 px-2.5 py-1 rounded transition"
          >
            {errorItem.equipment_type} Directory &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {relatedCategoryErrors.map((rel: any) => {
            const relBrandSlug = rel.brand_slug || rel.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            return (
              <a
                href={`/${relBrandSlug}/${rel.slug}/`}
                class="p-4 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-md transition group flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between gap-1 mb-1.5">
                    <span class="font-bold text-xs text-slate-900 group-hover:text-amber-600 transition truncate">
                      {rel.brand}
                    </span>
                    <span class="inline-block px-1.5 py-0.5 rounded font-mono font-bold text-[11px] bg-slate-100 text-amber-700 border border-slate-200">
                      {rel.error_code}
                    </span>
                  </div>
                  <h3 class="text-xs font-medium text-slate-700 line-clamp-2 mb-1.5">
                    {rel.short_symptom}
                  </h3>
                  <div class="text-[11px] font-mono text-slate-500 truncate">
                    {rel.primary_part_name}
                  </div>
                </div>
                <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] font-mono text-slate-400">
                  <span>OEM: {rel.oem_part_number}</span>
                  <span class="text-amber-600 font-bold">Guide &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </article>

  <!-- Sticky Mobile CTA Bar -->
  <aside class="fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 backdrop-blur border-t border-slate-800 p-3 flex md:hidden items-center justify-between shadow-2xl">
    <div class="max-w-[50%]">
      <div class="text-[10px] uppercase font-mono text-amber-400">Error {errorItem.error_code} Part</div>
      <div class="text-xs font-bold text-white truncate">{errorItem.primary_part_name}</div>
    </div>
    <a
      href={errorItem.part_affiliate_url}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="inline-flex items-center justify-center px-3 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs tracking-wide shadow-md transition text-center"
    >
      <span>Check Price &amp; Stock for OEM #{errorItem.oem_part_number} on Amazon &rarr;</span>
    </a>
  </aside>

  <!-- Interactive Checklist Client Script -->
  <script is:inline>
    document.querySelectorAll('.checklist-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', (e) => {
        const item = e.target.closest('.checklist-item');
        const text = item.querySelector('.step-text');
        if (e.target.checked) {
          text.classList.add('line-through', 'text-slate-400');
          item.classList.add('bg-emerald-50/50', 'border-emerald-300');
        } else {
          text.classList.remove('line-through', 'text-slate-400');
          item.classList.remove('bg-emerald-50/50', 'border-emerald-300');
        }
      });
    });
  </script>
</MainLayout>
