---
import MainLayout from '../layouts/MainLayout.astro';
import errorsDb from '../data/errors_db.json';

// Group data by Brand and Equipment Type
const totalCodes = errorsDb.length;
const brandsMap = new Map<string, { name: string; slug: string; count: number; equipmentType: string }>();
const equipmentMap = new Map<string, { name: string; count: number; brands: Set<string> }>();

errorsDb.forEach((item: any) => {
  const brand = item.brand;
  const bSlug = item.brand_slug || brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  
  if (!brandsMap.has(brand)) {
    brandsMap.set(brand, { name: brand, slug: bSlug, count: 0, equipmentType: item.equipment_type });
  }
  brandsMap.get(brand)!.count += 1;

  const equip = item.equipment_type;
  if (!equipmentMap.has(equip)) {
    equipmentMap.set(equip, { name: equip, count: 0, brands: new Set<string>() });
  }
  const eqEntry = equipmentMap.get(equip)!;
  eqEntry.count += 1;
  eqEntry.brands.add(brand);
});

const brandsList = Array.from(brandsMap.values()).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const equipmentList = Array.from(equipmentMap.values())
  .map(eq => ({
    name: eq.name,
    count: eq.count,
    brands: Array.from(eq.brands).slice(0, 5),
  }))
  .sort((a, b) => b.count - a.count);

// FIX 5.1: Top 120 Most Common Fault Codes (top ~2 per brand) for initial SSR HTML
const topFaultCodes: any[] = [];
const brandSeenCount = new Map<string, number>();
for (const item of errorsDb as any[]) {
  const currentCount = brandSeenCount.get(item.brand) || 0;
  if (currentCount < 2 && topFaultCodes.length < 120) {
    topFaultCodes.push(item);
    brandSeenCount.set(item.brand, currentCount + 1);
  }
}
---

<MainLayout
  title="FixMyCode by GetTinyTool — OEM Appliance & Equipment Error Code Database"
  description="Instant OEM troubleshooting guides, error code diagnostics, and exact replacement part numbers for HVAC, pool heaters, dishwashers, and appliances."
  fullTitle={true}
>
  <!-- Hero Technical Header -->
  <section class="bg-slate-900 text-white border-b border-slate-800 py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-mono text-amber-400">
          <span>●</span>
          <span>PROGRAMMATIC REPAIR ENGINE • {totalCodes} FAULT CODES INDEXED</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
          Appliance &amp; Equipment <span class="text-amber-500">Service Manual</span> Database
        </h1>
        <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
          Direct troubleshooting instructions, root causes, technician fix steps, and exact OEM part replacements extracted from certified technical documentation.
        </p>

        <!-- Live Instant Search Bar with Immediate Dropdown Feedback -->
        <div class="pt-4 max-w-2xl relative">
          <div class="relative">
            <input
              type="text"
              id="searchInput"
              placeholder="Search by code (e.g. E24, SFS, P0300) or brand (Bosch, Pentair, Toyota)..."
              class="w-full bg-slate-800 border-2 border-slate-700 text-white placeholder-slate-400 text-sm sm:text-base rounded-xl py-3.5 pl-11 pr-24 focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 font-sans shadow-inner transition"
              autocomplete="off"
              spellcheck="false"
            />
            <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <div class="absolute right-3 top-3 hidden sm:flex items-center gap-1.5 text-[11px] font-mono text-slate-400 bg-slate-900/90 px-2 py-1 rounded border border-slate-700">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Instant Fix</span>
            </div>
          </div>

          <!-- Hero Instant Floating Dropdown -->
          <div
            id="heroSearchDropdown"
            class="hidden absolute left-0 right-0 top-full mt-2 z-50 bg-slate-900/95 border border-slate-700 rounded-2xl shadow-2xl overflow-hidden divide-y divide-slate-800 backdrop-blur-md transition-all"
          >
            <div id="heroDropdownStatus" class="px-4 py-2 bg-slate-950/80 text-[11px] font-mono text-slate-400 flex items-center justify-between border-b border-slate-800">
              <span id="heroMatchCount">Matching OEM Guides</span>
              <span class="text-amber-500 font-semibold hidden sm:inline">Press Enter ↵ to open</span>
            </div>
            <div id="heroDropdownResults" class="max-h-80 overflow-y-auto p-1.5 space-y-1"></div>
            <div id="heroDropdownFooter" class="p-2.5 bg-slate-950 text-center text-xs font-mono border-t border-slate-800">
              <a href="#codesTable" id="viewAllResultsBtn" class="text-amber-400 hover:text-amber-300 font-semibold inline-flex items-center gap-1">
                View all results in table below &darr;
              </a>
            </div>
          </div>

          <p class="text-xs text-slate-400 mt-2 font-mono">
            Pro Tip: Type your appliance error code to jump directly to the verified fix guide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Technical Metrics Bar -->
  <section class="bg-white border-b border-slate-200 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center divide-x divide-slate-100">
        <div>
          <div class="text-2xl sm:text-3xl font-black font-mono text-slate-900">{totalCodes}</div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mt-1">Verified Fault Codes</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black font-mono text-slate-900">{brandsList.length}</div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mt-1">Supported Brands</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black font-mono text-slate-900">~75%</div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mt-1">Average DIY Savings</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black font-mono text-amber-600">OEM</div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mt-1">Manual Calibrated</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- FIX 5.1: All 77 Manufacturer Brand Hub Cards -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Browse All 77 Manufacturer Hubs</h2>
          <p class="text-xs text-slate-500">Direct OEM manual feeds and complete model repair indexes</p>
        </div>
        <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded">
          {brandsList.length} Hubs
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {brandsList.map((brand) => (
          <a
            href={`/${brand.slug}/`}
            class="flex flex-col justify-between p-3.5 rounded-xl border border-slate-200 bg-white hover:border-amber-500 hover:shadow-md transition group"
          >
            <span class="text-sm font-bold text-slate-900 group-hover:text-amber-600 transition truncate">
              {brand.name}
            </span>
            <span class="text-[11px] font-mono text-slate-500 mt-1">
              {brand.count} Codes &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- FIX 5.1: Equipment Category Grid Linking to Top Brands -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900">Browse by Equipment Category</h2>
          <p class="text-xs text-slate-500">Filter fault code directories by machine type</p>
        </div>
        <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded">
          {equipmentList.length} Categories
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {equipmentList.map((eq) => (
          <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-2xs space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-slate-900 truncate">{eq.name}</h3>
              <span class="text-[11px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-medium">
                {eq.count}
              </span>
            </div>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {eq.brands.map((b) => {
                const bSlug = b.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                return (
                  <a
                    href={`/${bSlug}/`}
                    class="text-[11px] px-2 py-0.5 rounded bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 transition"
                  >
                    {b}
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- FIX 5.1: Top 120 Most Common Fault Codes SSR Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-900" id="tableHeading">Featured Diagnostic Codes</h2>
          <p class="text-xs text-slate-500" id="tableSubheading">Top indexed error codes across all 77 manufacturer product lines</p>
        </div>
        <span id="resultsCount" class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded">
          Showing {topFaultCodes.length} Fault Guides
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm" id="codesTable">
          <thead class="bg-slate-50 text-slate-700 text-xs font-mono uppercase border-b border-slate-200">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Error Code</th>
              <th class="py-3.5 px-4 font-semibold">Brand &amp; Equipment</th>
              <th class="py-3.5 px-4 font-semibold">Model Series</th>
              <th class="py-3.5 px-4 font-semibold">Symptom</th>
              <th class="py-3.5 px-4 font-semibold">Primary Part</th>
              <th class="py-3.5 px-4 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="divide-y divide-slate-200 text-slate-700 font-sans">
            {topFaultCodes.map((item) => {
              const bSlug = item.brand_slug || item.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              return (
                <tr class="hover:bg-amber-50/40 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900">
                    <span class="bg-slate-100 border border-slate-300 px-2 py-0.5 rounded text-amber-700">
                      {item.error_code}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-900">{item.brand}</div>
                    <div class="text-[11px] text-slate-500">{item.equipment_type}</div>
                  </td>
                  <td class="py-3.5 px-4 text-xs font-mono text-slate-600 max-w-xs truncate">
                    {item.model_series}
                  </td>
                  <td class="py-3.5 px-4 max-w-xs">
                    <span class="text-slate-800 text-xs line-clamp-1">{item.short_symptom}</span>
                  </td>
                  <td class="py-3.5 px-4 text-xs font-mono font-medium text-slate-900">
                    {item.primary_part_name}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <a
                      href={`/${bSlug}/${item.slug}/`}
                      class="inline-flex items-center gap-1 text-xs font-bold font-mono px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-600 text-white transition"
                    >
                      Fix Guide &rarr;
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Instant Search Engine with Cached Promise & Floating Dropdown Feedback -->
  <script is:inline>
    (function () {
      let searchIndexPromise = null;
      let activeIndex = -1;

      function getSearchIndex() {
        if (!searchIndexPromise) {
          searchIndexPromise = fetch('/search-index.json')
            .then((res) => {
              if (!res.ok) throw new Error('HTTP ' + res.status);
              return res.json();
            })
            .catch((err) => {
              searchIndexPromise = null;
              console.error('Failed to load search index:', err);
              return [];
            });
        }
        return searchIndexPromise;
      }

      const searchInput = document.getElementById('searchInput');
      const dropdown = document.getElementById('heroSearchDropdown');
      const dropdownResults = document.getElementById('heroDropdownResults');
      const heroMatchCount = document.getElementById('heroMatchCount');
      const tableBody = document.getElementById('tableBody');
      const resultsCount = document.getElementById('resultsCount');
      const tableHeading = document.getElementById('tableHeading');
      const tableSubheading = document.getElementById('tableSubheading');

      let initialHtml = tableBody ? tableBody.innerHTML : '';

      function closeDropdown() {
        if (dropdown) dropdown.classList.add('hidden');
        activeIndex = -1;
      }

      function openDropdown() {
        if (dropdown) dropdown.classList.remove('hidden');
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#searchInput') && !e.target.closest('#heroSearchDropdown')) {
          closeDropdown();
        }
      });

      if (searchInput) {
        // Pre-fetch on hover or focus
        searchInput.addEventListener('focus', () => {
          getSearchIndex();
          if (searchInput.value.trim() && dropdownResults && dropdownResults.children.length > 0) {
            openDropdown();
          }
        });
        searchInput.addEventListener('mouseenter', getSearchIndex);

        // Keyboard navigation (Arrow keys + Enter + Esc)
        searchInput.addEventListener('keydown', (e) => {
          const items = dropdownResults ? dropdownResults.querySelectorAll('.hero-search-item') : [];
          if (!items.length) return;

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            activeIndex = (activeIndex + 1) % items.length;
            updateActiveItem(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activeIndex = (activeIndex - 1 + items.length) % items.length;
            updateActiveItem(items);
          } else if (e.key === 'Enter') {
            e.preventDefault();
            if (activeIndex >= 0 && activeIndex < items.length) {
              items[activeIndex].click();
            } else if (items.length > 0) {
              items[0].click();
            }
          } else if (e.key === 'Escape') {
            closeDropdown();
          }
        });

        function updateActiveItem(items) {
          items.forEach((item, idx) => {
            if (idx === activeIndex) {
              item.classList.add('bg-slate-800', 'border-amber-500/50');
              item.scrollIntoView({ block: 'nearest' });
            } else {
              item.classList.remove('bg-slate-800', 'border-amber-500/50');
            }
          });
        }

        searchInput.addEventListener('input', async (e) => {
          const query = e.target.value.toLowerCase().trim();
          activeIndex = -1;

          if (!query) {
            closeDropdown();
            if (tableBody) tableBody.innerHTML = initialHtml;
            if (resultsCount) resultsCount.textContent = 'Showing 120 Fault Guides';
            if (tableHeading) tableHeading.textContent = 'Featured Diagnostic Codes';
            if (tableSubheading) tableSubheading.textContent = 'Top indexed error codes across all 77 manufacturer product lines';
            return;
          }

          openDropdown();
          if (dropdownResults) {
            dropdownResults.innerHTML = `
              <div class="py-4 text-center text-xs font-mono text-slate-400">
                Searching 3,581 error codes...
              </div>
            `;
          }

          const index = await getSearchIndex();
          if (!index || !index.length) {
            if (dropdownResults) {
              dropdownResults.innerHTML = `
                <div class="py-4 text-center text-xs font-mono text-slate-400">
                  Loading manual index...
                </div>
              `;
            }
            return;
          }

          // Double check if query changed while fetching
          const currentQuery = searchInput.value.toLowerCase().trim();
          if (currentQuery !== query) return;

          const terms = query.split(/\s+/).filter(Boolean);
          const matches = [];

          for (let i = 0; i < index.length; i++) {
            const item = index[i];
            const haystack = `${item.c} ${item.b} ${item.m} ${item.s} ${item.p} ${item.e} ${item.n}`.toLowerCase();
            if (terms.every((t) => haystack.includes(t))) {
              matches.push(item);
              if (matches.length >= 100) break;
            }
          }

          // Render instant dropdown top 6 matches
          if (matches.length === 0) {
            if (dropdownResults) {
              dropdownResults.innerHTML = `
                <div class="py-6 px-4 text-center">
                  <p class="text-xs text-slate-300 font-medium">No direct matches for "${e.target.value}"</p>
                  <p class="text-[11px] text-slate-500 mt-1">Try entering just the code number (e.g. E24, SFS, P0300)</p>
                </div>
              `;
            }
            if (heroMatchCount) heroMatchCount.textContent = '0 Matches';
          } else {
            if (heroMatchCount) {
              heroMatchCount.textContent = `${matches.length} Matching Guides`;
            }
            const topDropdown = matches.slice(0, 6);
            if (dropdownResults) {
              dropdownResults.innerHTML = topDropdown.map((m, idx) => `
                <a
                  href="${m.u}"
                  class="hero-search-item flex items-center justify-between p-2.5 rounded-xl border border-transparent hover:bg-slate-800 transition text-left block"
                  data-idx="${idx}"
                >
                  <div class="min-w-0 pr-3">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="font-mono font-bold text-xs px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        ${m.c}
                      </span>
                      <span class="text-xs font-bold text-white truncate">${m.b}</span>
                      <span class="text-[10px] text-slate-400 font-mono">${m.e}</span>
                    </div>
                    <div class="text-xs text-slate-300 truncate">${m.s}</div>
                  </div>
                  <span class="text-[11px] font-mono font-semibold px-2 py-1 rounded bg-slate-800 text-amber-400 border border-slate-700 flex-shrink-0">
                    Fix &rarr;
                  </span>
                </a>
              `).join('');
            }
          }

          // Also update table below
          if (tableHeading) tableHeading.textContent = `Search Results for "${e.target.value}"`;
          if (tableSubheading) tableSubheading.textContent = `Found ${matches.length} matching OEM error code guides`;
          if (resultsCount) resultsCount.textContent = `Showing ${matches.length} Results`;

          if (matches.length === 0) {
            if (tableBody) {
              tableBody.innerHTML = `
                <tr>
                  <td colspan="6" class="py-12 text-center text-slate-500 font-mono text-sm">
                    No matching error codes found for "${e.target.value}". Try searching by code number (e.g. E24, SFS) or appliance brand.
                  </td>
                </tr>
              `;
            }
          } else {
            if (tableBody) {
              tableBody.innerHTML = matches.map((m) => `
                <tr class="hover:bg-amber-50/40 transition">
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900">
                    <span class="bg-slate-100 border border-slate-300 px-2 py-0.5 rounded text-amber-700">
                      ${m.c}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-900">${m.b}</div>
                    <div class="text-[11px] text-slate-500">${m.e}</div>
                  </td>
                  <td class="py-3.5 px-4 text-xs font-mono text-slate-600 max-w-xs truncate">
                    ${m.m}
                  </td>
                  <td class="py-3.5 px-4 max-w-xs">
                    <span class="text-slate-800 text-xs line-clamp-1">${m.s}</span>
                  </td>
                  <td class="py-3.5 px-4 text-xs font-mono font-medium text-slate-900">
                    ${m.n || m.p}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <a
                      href="${m.u}"
                      class="inline-flex items-center gap-1 text-xs font-bold font-mono px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-600 text-white transition"
                    >
                      Fix Guide &rarr;
                    </a>
                  </td>
                </tr>
              `).join('');
            }
          }
        });
      }
    })();
  </script>
</MainLayout>
