---
interface Props {
  brand: string;
  modelSeries: string;
  errorCode: string;
  partName: string;
  oemPartNumber: string;
  crossRefNumbers?: string;
  multimeterSpec?: string;
  toolsNeeded?: string;
  partAffiliateUrl?: string;
  requiredToolName?: string;
  toolAffiliateUrl?: string;
  amazonTag?: string;
}

const {
  brand,
  modelSeries,
  errorCode,
  partName,
  oemPartNumber,
  crossRefNumbers = '',
  multimeterSpec = '',
  toolsNeeded = '',
  partAffiliateUrl,
  requiredToolName = 'Digital Multimeter',
  toolAffiliateUrl,
  amazonTag = 'amazinrevie0a-20',
} = Astro.props;

// Build dynamic Amazon search URL prioritizing OEM Part Number
const cleanPart = partName.replace(/\(.*?\)/g, '').trim();
const hasValidOem = oemPartNumber && !oemPartNumber.toLowerCase().includes('check') && oemPartNumber !== 'N/A';
const partSearchQuery = hasValidOem
  ? `${brand} ${oemPartNumber} ${cleanPart}`
  : `${brand} ${modelSeries} ${cleanPart}`;
const primaryAmazonUrl = partAffiliateUrl || `https://www.amazon.com/s?k=${encodeURIComponent(partSearchQuery)}&tag=${amazonTag}`;

// Secondary Tool search URL
const effectiveToolUrl = toolAffiliateUrl || `https://www.amazon.com/s?k=${encodeURIComponent(requiredToolName)}&tag=${amazonTag}`;

// Fallbacks for display
const displayOem = hasValidOem ? oemPartNumber : 'Check Model Plate';
const displayCrossRef = crossRefNumbers || (hasValidOem ? `${oemPartNumber}, ${oemPartNumber.replace(/[^A-Za-z0-9]/g, '')}, AP-Direct` : 'OEM Factory Standard');
const displaySpec = multimeterSpec || 'Continuity: < 1.0 Ω closed; check operating voltage with multimeter';
const displayTools = toolsNeeded || `${requiredToolName}, Insulated Screwdriver Set, Work Gloves`;

// Unique ID for copy button
const copyBtnId = `copy-btn-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="my-4 rounded-2xl border-2 border-slate-900 bg-white shadow-xl overflow-hidden font-sans">
  <!-- Card Header Strip -->
  <div class="bg-slate-900 text-white px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3 border-b-2 border-slate-800">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-amber-500 text-slate-950 font-black text-xs">
        !
      </span>
      <span class="text-xs sm:text-sm font-black tracking-wide font-mono uppercase text-amber-400">
        EMERGENCY REPAIR SPECIFICATION • ERROR {errorCode}
      </span>
    </div>
    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-bold uppercase bg-emerald-500 text-slate-950">
      <span class="w-1.5 h-1.5 rounded-full bg-slate-950 animate-pulse"></span>
      Primary Fault Component
    </span>
  </div>

  <!-- Main Technical Spec Grid -->
  <div class="p-4 sm:p-6 bg-gradient-to-b from-amber-50/40 via-white to-white space-y-4">
    <!-- Component Name & OEM Badge -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
      <div class="space-y-1">
        <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500 block">
          Diagnosed Faulty Component
        </span>
        <h3 class="text-lg sm:text-xl font-black text-slate-900 leading-tight">
          {partName}
        </h3>
      </div>

      <!-- OEM Part Number + Copy Button -->
      <div class="flex items-center gap-2 self-start sm:self-auto bg-slate-100 border border-slate-300 rounded-lg p-1.5 pr-2.5">
        <div class="px-2 py-1 bg-white border border-slate-200 rounded text-xs font-mono font-bold text-slate-900 shadow-xs">
          OEM: <span class="text-amber-700">{displayOem}</span>
        </div>
        {hasValidOem && (
          <button
            type="button"
            id={copyBtnId}
            data-part={displayOem}
            class="copy-part-btn inline-flex items-center gap-1 text-[11px] font-mono font-semibold text-slate-700 hover:text-amber-700 transition px-1.5 py-0.5 rounded hover:bg-slate-200 cursor-pointer"
            title="Copy OEM Part Number"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span class="copy-label">Copy Part #</span>
          </button>
        )}
      </div>
    </div>

    <!-- Diagnostic Specs: Multimeter & Cross-Ref -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
      <!-- Multimeter / Diagnostic Spec -->
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="flex items-center gap-1.5 text-amber-700 font-mono font-bold uppercase text-[11px]">
          <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Diagnostic / Multimeter Spec</span>
        </div>
        <p class="text-slate-800 font-mono text-[11px] leading-relaxed">
          {displaySpec}
        </p>
      </div>

      <!-- Cross Reference Numbers -->
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="flex items-center gap-1.5 text-slate-700 font-mono font-bold uppercase text-[11px]">
          <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>Replaces / Cross-Reference Numbers</span>
        </div>
        <p class="text-slate-700 font-mono text-[11px] leading-relaxed break-words">
          {displayCrossRef}
        </p>
      </div>
    </div>

    <!-- Required Tools Line -->
    <div class="p-3 rounded-xl bg-slate-100/80 border border-slate-200/80 flex flex-wrap items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-mono font-bold uppercase text-[11px] text-slate-500">Required Tools:</span>
        <span class="font-medium text-slate-800">{displayTools}</span>
      </div>
      <span class="text-[11px] font-mono text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
        Zero Special Tools Required
      </span>
    </div>

    <!-- HIGH-CONVERSION AMAZON CALLS TO ACTION -->
    <div class="pt-2 space-y-2.5">
      <!-- Primary OEM Part Button -->
      <a
        href={primaryAmazonUrl}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="flex items-center justify-center w-full px-5 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm sm:text-base tracking-wide shadow-md hover:shadow-xl hover:shadow-amber-500/20 transition-all duration-150 transform hover:-translate-y-0.5 group text-center"
      >
        <span>Check Price &amp; Compatibility for OEM #{displayOem} on Amazon &rarr;</span>
      </a>

      <!-- Secondary Tools Button Directly Below -->
      <a
        href={effectiveToolUrl}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="flex items-center justify-center w-full px-4 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-100 font-semibold text-xs sm:text-sm tracking-wide shadow-sm hover:shadow transition text-center"
      >
        <span>View Required Repair Tools ({requiredToolName}) on Amazon &rarr;</span>
      </a>
    </div>
  </div>

  <!-- Bottom Verification Guarantee -->
  <div class="bg-slate-50 px-4 sm:px-6 py-2 border-t border-slate-200 flex flex-wrap items-center justify-between text-[11px] text-slate-500 font-mono">
    <span>Verified Against Manufacturer Tech Sheets</span>
    <span>Direct OEM Tolerances Guaranteed</span>
  </div>
</div>

<!-- One-Click Copy Part # Script -->
<script is:inline>
  document.querySelectorAll('.copy-part-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const part = btn.getAttribute('data-part');
      if (!part) return;
      navigator.clipboard.writeText(part).then(() => {
        const label = btn.querySelector('.copy-label');
        if (label) {
          const originalText = label.textContent;
          label.textContent = 'Copied!';
          btn.classList.add('text-emerald-700', 'bg-emerald-50');
          setTimeout(() => {
            label.textContent = originalText;
            btn.classList.remove('text-emerald-700', 'bg-emerald-50');
          }, 2000);
        }
      });
    });
  });
</script>
