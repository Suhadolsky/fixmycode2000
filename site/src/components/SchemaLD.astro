---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  brand: string;
  modelSeries: string;
  errorCode: string;
  shortSymptom: string;
  plainEnglishMeaning: string;
  estimatedCost: string;
  steps: string[];
  primaryPartName: string;
  oemPartNumber?: string;
  brandSlug?: string;
  slug?: string;
  consumableName: string;
  requiredToolName: string;
  faqQuestions: FAQItem[];
}

const {
  brand,
  modelSeries,
  errorCode,
  shortSymptom,
  plainEnglishMeaning,
  estimatedCost,
  steps,
  primaryPartName,
  oemPartNumber,
  brandSlug,
  slug,
  consumableName,
  requiredToolName,
  faqQuestions = [],
} = Astro.props;

// FIX 4.1: Parse numeric range for valid Schema.org MonetaryAmount
const costMatches = (estimatedCost || '').match(/\d+/g)?.map(Number) || [150, 300];
const minCost = costMatches[0] || 120;
const maxCost = costMatches.length > 1 ? costMatches[1] : Math.round(minCost * 1.4);

// Build Schema.org HowTo Step Objects
const howToSteps = steps.map((stepText, idx) => ({
  "@type": "HowToStep",
  position: idx + 1,
  name: `Step ${idx + 1}: Diagnostic & Repair Procedure`,
  text: stepText,
}));

// Build Schema.org FAQ Objects
const faqEntities = (faqQuestions || []).map((faq) => ({
  "@type": "Question",
  name: faq.question,
  acceptedAnswer: {
    "@type": "Answer",
    text: faq.answer,
  },
}));

const effectiveBrandSlug = brandSlug || brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const effectiveUrl = slug
  ? `https://gettinytool.com/${effectiveBrandSlug}/${slug}/`
  : `https://gettinytool.com/${effectiveBrandSlug}/`;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      name: `How to Fix ${brand} ${modelSeries} Error Code ${errorCode}: ${shortSymptom}`,
      description: plainEnglishMeaning,
      estimatedCost: {
        "@type": "MonetaryAmount",
        currency: "USD",
        minValue: minCost,
        maxValue: maxCost,
      },
      supply: [
        {
          "@type": "HowToSupply",
          name: primaryPartName,
          ...(oemPartNumber ? { identifier: oemPartNumber, mpn: oemPartNumber } : {}),
        },
        {
          "@type": "HowToSupply",
          name: consumableName,
        },
      ],
      tool: [
        {
          "@type": "HowToTool",
          name: requiredToolName,
        },
      ],
      step: howToSteps,
    },
    {
      "@type": "FAQPage",
      mainEntity: faqEntities,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://gettinytool.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: brand,
          item: `https://gettinytool.com/${effectiveBrandSlug}/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: `Error ${errorCode}`,
          item: effectiveUrl,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
