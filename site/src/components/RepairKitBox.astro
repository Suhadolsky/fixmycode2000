---
interface Props {
  brand?: string;
  errorCode: string;
  primaryPartName: string;
  oemPartNumber: string;
  partAffiliateUrl: string;
  requiredToolName: string;
  toolAffiliateUrl: string;
  consumableName: string;
  consumableAffiliateUrl: string;
  bundleCartUrl?: string;
  hasAsinBundle?: boolean;
}

const {
  brand = '',
  errorCode,
  primaryPartName,
  oemPartNumber,
  partAffiliateUrl,
  requiredToolName,
  toolAffiliateUrl,
  consumableName,
  consumableAffiliateUrl,
  bundleCartUrl,
} = Astro.props;

// Build clean search URLs if not provided
const cleanPart = primaryPartName.replace(/\(.*?\)/g, '').trim();
const hasOem = oemPartNumber && !oemPartNumber.toLowerCase().includes('check') && oemPartNumber !== 'N/A';
const partSearchQuery = hasOem ? `${brand} ${oemPartNumber} ${cleanPart}`.trim() : `${brand} ${cleanPart}`.trim();
const cleanPartUrl = partAffiliateUrl || `https://www.amazon.com/s?k=${encodeURIComponent(partSearchQuery)}&tag=amazinrevie0a-20`;

const bundleSearchQuery = hasOem
  ? `${brand} ${oemPartNumber} ${cleanPart} replacement kit`.trim()
  : `${brand} ${cleanPart} repair kit`.trim();
const cleanBundleUrl = bundleCartUrl || `https://www.amazon.com/s?k=${encodeURIComponent(bundleSearchQuery)}&tag=amazinrevie0a-20`;

const copyBtnId = `copy-rk-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="my-8 rounded-2xl border-2 border-slate-900 bg-white shadow-xl overflow-hidden font-sans">
  <!-- Box Header -->
  <div class="bg-slate-900 text-white px-5 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-3 border-b-2 border-slate-800">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-amber-500 text-slate-950 font-bold text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
        </svg>
      </span>
      <h3 class="text-base sm:text-lg font-black tracking-tight text-white uppercase font-mono">
        REQUIRED REPAIR KIT &amp; PARTS FOR ERROR <span class="text-amber-400">{errorCode}</span>
      </h3>
    </div>
    <span class="text-[11px] font-mono uppercase bg-slate-800 text-slate-300 px-2.5 py-1 rounded border border-slate-700">
      Verified Tech Spec
    </span>
  </div>

  <!-- Rows Container -->
  <div class="divide-y divide-slate-200">
    <!-- Row 1: Primary Replacement Part (High-Conversion Hero Row) -->
    <div class="p-5 sm:p-6 bg-gradient-to-r from-amber-50/60 to-white flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold font-mono tracking-wider bg-amber-500 text-slate-950 uppercase shadow-xs">
            [1. REPLACEMENT PART]
          </span>
          {oemPartNumber && (
            <div class="inline-flex items-center gap-1.5 bg-slate-100 border border-slate-300 rounded px-2 py-0.5 text-[11px] font-mono">
              <span class="text-slate-600">OEM:</span>
              <strong class="text-slate-900">{oemPartNumber}</strong>
              <button
                type="button"
                id={copyBtnId}
                data-part={oemPartNumber}
                class="copy-rk-btn ml-1 px-1.5 py-0.2 rounded text-[10px] bg-white border border-slate-200 hover:bg-slate-200 text-slate-700 font-semibold cursor-pointer transition"
                title="Copy OEM Part Number"
              >
                <span class="copy-rk-label">Copy OEM #</span>
              </button>
            </div>
          )}
        </div>
        <h4 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
          {primaryPartName}
        </h4>
        <p class="text-xs text-slate-600">
          Direct manufacturer-spec or certified OEM replacement assembly for permanent fix.
        </p>
      </div>

      <div class="md:text-right shrink-0">
        <a
          href={cleanPartUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="inline-flex items-center justify-center w-full md:w-auto px-5 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-sm tracking-wide shadow-md hover:shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 group"
        >
          <span>Check Price &amp; Stock for OEM #{oemPartNumber} on Amazon &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Row 2: Required Tool -->
    <div class="p-5 sm:p-6 bg-white flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 flex-1">
        <div class="flex items-center gap-2">
          <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold font-mono tracking-wider bg-slate-200 text-slate-800 uppercase">
            [2. REQUIRED TOOL]
          </span>
        </div>
        <h4 class="text-base sm:text-lg font-semibold text-slate-900">
          {requiredToolName}
        </h4>
        <p class="text-xs text-slate-500">
          Required to safely access chassis fasteners and test electrical continuity.
        </p>
      </div>

      <div class="md:text-right shrink-0">
        <a
          href={toolAffiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="inline-flex items-center justify-center w-full md:w-auto px-4 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-100 font-semibold text-xs tracking-wide shadow-sm hover:shadow transition"
        >
          <span>View Tool on Amazon</span>
          <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Row 3: Preventative Consumable -->
    <div class="p-5 sm:p-6 bg-white flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 flex-1">
        <div class="flex items-center gap-2">
          <span class="inline-block px-2 py-0.5 rounded text-[11px] font-bold font-mono tracking-wider bg-slate-200 text-slate-800 uppercase">
            [3. RECOMMENDED CONSUMABLE]
          </span>
        </div>
        <h4 class="text-base sm:text-lg font-semibold text-slate-900">
          {consumableName}
        </h4>
        <p class="text-xs text-slate-500">
          Protects mating O-rings and prevents re-corrosion or repeat error codes.
        </p>
      </div>

      <div class="md:text-right shrink-0">
        <a
          href={consumableAffiliateUrl}
          target="_blank"
          rel="sponsored nofollow noopener"
          class="inline-flex items-center justify-center w-full md:w-auto px-4 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-100 font-semibold text-xs tracking-wide shadow-sm hover:shadow transition"
        >
          <span>View on Amazon</span>
          <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Complete OEM Part + Service Kit Search on Amazon -->
  <div class="p-5 sm:p-6 bg-slate-900 text-white border-t-2 border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1 max-w-xl">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold tracking-wider bg-amber-500 text-slate-950 uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-950 animate-pulse"></span>
          Complete Service Kit
        </span>
        <span class="text-[11px] font-mono text-slate-400">All-in-One Fix</span>
      </div>
      <h4 class="text-base sm:text-lg font-bold text-white">
        Complete OEM Part + Service Kit Search on Amazon
      </h4>
      <p class="text-xs text-slate-400">
        Find matching OEM part #{oemPartNumber}, certified service kits, and compatible sealants on Amazon in one search.
      </p>
    </div>

    <div class="sm:text-right shrink-0">
      <a
        href={cleanBundleUrl}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm tracking-wide shadow-lg hover:shadow-amber-500/20 transition-all duration-150 transform hover:-translate-y-0.5"
      >
        <span>Search Complete Repair Kit on Amazon &rarr;</span>
      </a>
    </div>
  </div>

  <!-- Micro-notice beneath table -->
  <div class="bg-slate-50 px-5 sm:px-6 py-2.5 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500">
    <span>Live pricing and availability confirmed at Amazon checkout</span>
    <span class="font-mono">Parts match OEM tolerances</span>
  </div>
</div>

<!-- Copy button script for RepairKitBox -->
<script is:inline>
  document.querySelectorAll('.copy-rk-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const part = btn.getAttribute('data-part');
      if (!part) return;
      navigator.clipboard.writeText(part).then(() => {
        const label = btn.querySelector('.copy-rk-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          btn.classList.add('text-emerald-700', 'bg-emerald-50');
          setTimeout(() => {
            label.textContent = original;
            btn.classList.remove('text-emerald-700', 'bg-emerald-50');
          }, 2000);
        }
      });
    });
  });
</script>
